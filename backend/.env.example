# Référence des variables — en Docker, préfère les définir dans docker-compose.yml (service api).

PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# CORS_ORIGIN=https://ripper.example.com

# URL publique du site (meta og:url / canonical sur GET /v/:videoId). Derrière nginx : https://votredomaine.tld
# SITE_URL=https://example.com
# (alternative) PUBLIC_ORIGIN=https://example.com

# SEARCH_MAX_RESULTS=10

# Rare : binaire yt-dlp hors PATH dans l'image
# YT_DLP_PATH=/usr/local/bin/yt-dlp

# Titres / chaîne YouTube : langue des métadonnées (yt-dlp `youtube:lang`, défaut fr)
# YT_METADATA_LANG=fr

# Stats téléchargements (VPS) : GET /api/admin/download-stats avec Authorization: Bearer …
# ADMIN_STATS_SECRET=une_longue_chaine_aleatoire
# DOWNLOAD_STATS_PATH=/app/data/download-stats.json
# LOG_LEVEL=info

# Masque les lignes Pino « incoming request » / « request completed » pour GET
# /api/worker/delegations/next (poll fréquent). Désactiver : LOG_FILTER_DELEGATIONS_POLL=0
# LOG_FILTER_DELEGATIONS_POLL=1

# Connexion YouTube pour éviter la détection bot (optionnel)
# ⚠️ Ne jamais commiter ces credentials en clair !
# YOUTUBE_USERNAME=votre.email@gmail.com
# YOUTUBE_PASSWORD=votre_mot_de_passe
